{
  "id": "trip-segments",
  "name": "Trip Segments",
  "version": "1.3.0",
  "apiVersion": 1,
  "type": "trip-page",
  "trek": ">=4.0.0 <5.0.0",
  "author": "Renzo Beux",
  "description": "Split long multi-destination trips into colour-coded legs, with a per-leg view of the schedule, bookings and stays.",
  "homepage": "https://github.com/RenzoBeux/TREK-trip-segments",
  "license": "MIT",
  "icon": "Route",
  "tags": [
    "planning",
    "itinerary",
    "multi-destination"
  ],
  "nativeModules": false,
  "capabilities": {
    "tripPage": {
      "position": 1
    }
  },
  "settings": [
    {
      "key": "tintMode",
      "label": "Day tint",
      "input_type": "select",
      "scope": "user",
      "hint": "Which parts of a day get the leg colour. Applies next time you open a trip. On phones only the day chip is tinted, so only \"No tint\" looks different there.",
      "options": [
        {
          "value": "full-day",
          "label": "Whole day"
        },
        {
          "value": "header-badge",
          "label": "Header and badge"
        },
        {
          "value": "badge-only",
          "label": "Badge only"
        },
        {
          "value": "off",
          "label": "No tint (also hides the leg-name tooltip)"
        }
      ]
    }
  ],
  "permissions": [
    "db:own",
    "db:read:trips",
    "ws:broadcast:trip",
    "hook:day-schedule-provider",
    "hook:day-tint-provider",
    "hook:map-layer-provider",
    "hook:pdf-section-provider",
    "hook:trip-card-provider"
  ]
}
