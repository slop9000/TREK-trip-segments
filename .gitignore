node_modules/
.trek-dev/
*.zip

# Clean mirror of the shipped files, regenerated by every build. This is what you
# point TREK's "Link a local plugin" at — the repo root cannot be linked because
# TREK's native-binary scan walks node_modules and vitest pulls in rollup's .node.
.link/
coverage/
*.tsbuildinfo
.DS_Store

# NOTE: server/index.js, client/app.js and client/app.css are BUILD OUTPUT but are
# deliberately COMMITTED — `trek-plugin pack` and `validate` walk the working tree
# and require them on disk. `npm run verify` fails if they drift from source.
